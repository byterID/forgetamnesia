# OAuth Client ID (тип "Web application") из Google Cloud Console.
# Dev-клиент: origin http://localhost:5173. Prod-клиент задаётся в переменных Cloudflare Pages.
VITE_GOOGLE_CLIENT_ID=

# --- Set by scripts/setup-wizard.sh ---
# Google OAuth Web client ID for local dev (origin http://localhost:5173). Public, no secret.
VITE_GOOGLE_CLIENT_ID=
# Prod client ID (memo only; set it as VITE_GOOGLE_CLIENT_ID in Cloudflare Pages settings).
VITE_GOOGLE_CLIENT_ID_PROD=
# Cloudflare Pages production origin, e.g. https://forgetamnesia.pages.dev
PAGES_ORIGIN=
