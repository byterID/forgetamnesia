# Google OAuth Web client ID (public, no secret). Dev client: origin http://localhost:5173.
# In production set it in Cloudflare Pages settings (Prod client).
VITE_GOOGLE_CLIENT_ID=
# Prod client ID, memo only for scripts/setup-wizard.sh (not read by the app).
VITE_GOOGLE_CLIENT_ID_PROD=
# Cloudflare Pages production origin, e.g. https://forgetamnesia.pages.dev (used by the wizard).
PAGES_ORIGIN=
